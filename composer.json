{
    "name": "tryhackx/flarum-topic-rating",
    "description": "Interactive 5-star topic rating system for Flarum with half-star precision, live hover previews, real-time polling updates, per-device list styles, and advanced per-tag permissions.",
    "keywords": [
        "flarum",
        "extension",
        "rating",
        "stars",
        "5-star",
        "half-star",
        "discussion",
        "tag-permissions",
        "moderation",
        "review"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0-rc.1"
    },
    "authors": [
        {
            "name": "TryHackX",
            "email": "contact@tryhackx.org",
            "homepage": "https://github.com/TryHackX"
        }
    ],
    "support": {
        "issues": "https://github.com/TryHackX/flarum-topic-rating/issues",
        "source": "https://github.com/TryHackX/flarum-topic-rating"
    },
    "autoload": {
        "psr-4": {
            "TryHackX\\TopicRating\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Topic Rating",
            "category": "feature",
            "icon": {
                "name": "fas fa-star",
                "color": "#ffffff",
                "backgroundColor": "#f0ad4e"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}